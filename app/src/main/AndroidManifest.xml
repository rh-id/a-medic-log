<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk
        tools:overrideLibrary="m.co.rh.id.apoi_spreadsheet" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- exact alarm scheduling for medicine reminders:
         USE_EXACT_ALARM covers API 33+ (granted at install),
         SCHEDULE_EXACT_ALARM covers API 31-32 (user-revocable),
         below API 31 exact alarms need no permission -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".app.MainApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Amediclog">
        <activity
            android:name=".app.MainActivity"
            android:configChanges="uiMode|locale|layoutDirection|orientation|screenSize|screenLayout|density|colorMode|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|smallestScreenSize"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Amediclog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="m.co.rh.id.a_medic_log.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <receiver android:name=".app.receiver.NotificationDeleteReceiver" android:exported="false" />
        <receiver android:name=".app.receiver.NotificationTakeMedicineReceiver" android:exported="false" />
        <receiver android:name=".app.receiver.NotificationDisableMedicineReminderReceiver" android:exported="false" />
        <receiver android:name=".app.receiver.NotificationSnoozeMedicineReminderReceiver" android:exported="false" />
        <!-- fires the scheduled medicine reminder alarm, only reached through
             the scheduler's explicit PendingIntent -->
        <receiver android:name=".app.receiver.MedicineReminderAlarmReceiver" android:exported="false" />
        <!-- re-schedules every reminder alarm after a reboot and after the
             exact-alarm permission state changed (API 31+) -->
        <receiver android:name=".app.receiver.MedicineReminderBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
    </application>
</manifest>